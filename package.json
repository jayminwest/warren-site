{
	"name": "warren-site",
	"version": "0.1.0",
	"private": true,
	"description": "Marketing site and documentation for warren — warren.run",
	"type": "module",
	"engines": {
		"bun": ">=1.1.0"
	},
	"author": "Jaymin West",
	"license": "MIT",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"sync:upstream": "bun run scripts/sync-upstream.ts",
		"test": "bun test",
		"lint": "biome check --error-on-warnings . && bun run scripts/check-prose.ts",
		"lint:fix": "biome check --write --error-on-warnings . && bun run scripts/check-prose.ts",
		"check:prose": "bun run scripts/check-prose.ts",
		"typecheck": "astro check --minimumSeverity error && tsc --noEmit",
		"check:agents": "bun run scripts/validate-agents-md.ts",
		"check:dups": "bunx jscpd",
		"check:deps": "knip --dependencies",
		"check:size": "bun run scripts/check-file-sizes.ts",
		"check:debt": "bun run scripts/check-debt-markers.ts",
		"check:bundle-size": "bun run scripts/check-bundle-size.ts --build && bun run scripts/check-a11y.ts",
		"gen:docs:check": "bun run scripts/sync-upstream.ts --check",
		"check:coverage": "bun run scripts/check-coverage.ts",
		"check:coverage:ci": "bun run scripts/check-coverage.ts --junit",
		"check:ci-parity": "bun scripts/check-ci-parity.ts",
		"check:all": "bun scripts/check-all.ts",
		"verify": "bun run check:all",
		"test:ci": "mkdir -p test-results && bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage --reporter=junit --reporter-outfile=test-results/junit.xml",
		"report:test-timing": "bun run scripts/report-test-timing.ts",
		"report:quality-metrics": "bun run scripts/report-quality-metrics.ts",
		"prepare": "[ -e .git ] && git config core.hooksPath scripts/hooks || true"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.2.1",
		"@astrojs/starlight": "^0.41.4",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"astro": "^7.1.4",
		"starlight-links-validator": "^0.25.2",
		"starlight-llms-txt": "^0.11.0",
		"starlight-openapi": "^0.26.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.5",
		"@types/bun": "^1.3.14",
		"@types/jsdom": "^28.0.3",
		"axe-core": "^4.12.1",
		"jsdom": "^30.0.0",
		"knip": "^6.29.0",
		"starlight-typedoc": "^0.23.0",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^5.9.3",
		"yaml": "^2.9.0"
	}
}
