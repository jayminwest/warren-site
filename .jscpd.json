{
	"$schema": "https://raw.githubusercontent.com/kucherenko/jscpd/master/packages/jscpd/schemas/jscpd.json",
	"pattern": "{src,scripts}/**/*.{ts,tsx}",
	"ignore": [
		"**/node_modules/**",
		"**/__golden__/**",
		"**/*.test.ts",
		"**/*.test.tsx",
		"src/content/**",
		"dist/**",
		".astro/**",
		".upstream/**",
		"coverage/**",
		"test-results/**"
	],
	"minTokens": 150,
	"threshold": 3,
	"reporters": ["consoleFull"],
	"absolute": false,
	"gitignore": true,
	"silent": false
}
