---
/**
 * `/extensions` — the public extension catalog.
 *
 * LAYOUT ONLY — no copy lives in this file. Every headline, label, and
 * paragraph comes from `content/extensions.md`, which the prose guard
 * (`bun run check:prose`) lints at zero violations. Catalog entries are
 * structured frontmatter on the same file: a hand-curated allowlist,
 * by design. Discovery-by-convention (a crawled GitHub topic) is a
 * later phase that starts only when entry volume justifies it — see
 * `docs/design/extensions.md` in the warren repository.
 *
 * Constraints this page must keep: zero client JavaScript, and no
 * color, font, or radius that is not a vendored warren token or a
 * field-manual derivation from `starlight-overrides.css` (the `--fm-*`
 * steps and `--font-serif`). No shadows at all — hairlines separate.
 */
import { Content as IntroBody, frontmatter as meta } from "../../content/extensions.md";
import BaseLayout from "../components/BaseLayout.astro";

/** A catalog entry, as authored in the content file's frontmatter. */
interface Entry {
	name: string;
	kind: string;
	status: string;
	summary: string;
	href: string;
}

/** A labeled link, as authored in frontmatter. */
interface Cta {
	label: string;
	href: string;
}

const page = meta as {
	eyebrow: string;
	heading: string;
	title: string;
	description: string;
	entries: Entry[];
	designDoc: Cta;
	propose: Cta;
};
---

<BaseLayout title={page.title} description={page.description}>
	<section class="shell head">
		<p class="eyebrow">{page.eyebrow}</p>
		<h1>{page.heading}</h1>
		<div class="intro"><IntroBody /></div>
	</section>

	<section class="shell catalog">
		<ul class="entries">
			{
				page.entries.map((entry) => (
					<li class="entry">
						<div class="entry-head">
							<span class="kind">{entry.kind}</span>
							<span class="status">{entry.status}</span>
						</div>
						<h2>
							<a href={entry.href} rel="noopener noreferrer">
								{entry.name}
							</a>
						</h2>
						<p>{entry.summary}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="shell links">
		<a href={page.designDoc.href} rel="noopener noreferrer">{page.designDoc.label}</a>
		<a href={page.propose.href} rel="noopener noreferrer">{page.propose.label}</a>
	</section>
</BaseLayout>

<style>
	.head {
		padding-block: 4rem 1rem;
	}

	/* The uppercase mono micro-label — the one sanctioned label style. */
	.eyebrow {
		margin: 0 0 1rem;
		color: var(--color-muted-foreground);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 2.5rem);
		line-height: 1.05;
	}

	.intro {
		max-width: 68ch;
		margin-top: 0.75rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-muted-foreground);
	}

	.intro :global(p) {
		margin: 0.75rem 0 0;
	}

	.catalog {
		padding-block: 1.5rem 0;
	}

	.entries {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* A field-manual tile: panel surface, hairline, hard-ish corners. */
	.entry {
		padding: 1rem 1.1rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		background-color: var(--color-card, var(--color-bg));
	}

	.entry-head {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}

	/* Pills are bordered objects: hairline, near-hard corners, no fill. */
	.kind,
	.status {
		padding: 0.0625rem 0.5rem;
		border: 1px solid var(--fm-line-strong);
		border-radius: 2px;
		font-size: 0.75rem;
		color: var(--color-muted-foreground);
	}

	/* Extension names are refs, and refs get the accent. */
	.entry h2 {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: 0;
	}

	.entry h2 a {
		color: var(--color-primary);
		text-decoration: none;
	}

	.entry h2 a:hover {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.entry p {
		margin: 0.5rem 0 0;
		color: var(--color-muted-foreground);
		font-size: 0.8125rem;
		line-height: 1.6;
	}

	.links {
		display: flex;
		gap: 1.5rem;
		padding-block: 2rem 4rem;
	}

	/* Secondary actions are text, not buttons. */
	.links a {
		color: var(--color-muted-foreground);
		font-size: 0.8125rem;
	}

	.links a:hover {
		color: var(--color-fg);
	}
</style>
