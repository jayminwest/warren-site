---
/**
 * Landing page.
 *
 * LAYOUT ONLY — no copy lives in this file. Every headline, label, and
 * paragraph comes from `content/*.md`, which the prose guard
 * (`bun run check:prose`) lints at zero violations. Structured bits
 * (eyebrows, headings, CTA label + href) come from each file's
 * frontmatter; prose comes from the markdown body, rendered through the
 * `Content` component so the guard sees it as prose.
 *
 * To change a word on this page, edit the markdown, not this file.
 *
 * Constraints this page must keep: no client JavaScript beyond the
 * analytics tags `BaseLayout` injects (see `src/config/analytics.ts`),
 * and no color, font, or radius that is not a vendored warren token or a
 * field-manual derivation from `starlight-overrides.css` (the `--fm-*`
 * steps and `--font-serif`). No shadows at all — hairlines separate.
 */
import { Content as ClosingBody, frontmatter as closingMeta } from "../../content/closing.md";
import {
	Content as ControlPlaneBody,
	frontmatter as controlPlaneMeta,
} from "../../content/control-plane.md";
import { Content as AuditBody, frontmatter as auditMeta } from "../../content/features/audit.md";
import { Content as CapBody, frontmatter as capMeta } from "../../content/features/cap.md";
import {
	Content as DispatchBody,
	frontmatter as dispatchMeta,
} from "../../content/features/dispatch.md";
import { Content as JudgeBody, frontmatter as judgeMeta } from "../../content/features/judge.md";
import {
	Content as SandboxBody,
	frontmatter as sandboxMeta,
} from "../../content/features/sandbox.md";
import { Content as SteerBody, frontmatter as steerMeta } from "../../content/features/steer.md";
import { Content as HeroBody, frontmatter as heroMeta } from "../../content/hero.md";
import {
	Content as HowItWorksBody,
	frontmatter as howItWorksMeta,
} from "../../content/how-it-works.md";
import { Content as RecordBody, frontmatter as recordMeta } from "../../content/record.md";
import { Content as SelfHostBody, frontmatter as selfHostMeta } from "../../content/self-host.md";
import BaseLayout from "../components/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import GitHubMark from "../components/GitHubMark.astro";
import Pipeline, { type Step } from "../components/Pipeline.astro";
import RunPanel, { type EventRow } from "../components/RunPanel.astro";
import facts from "../config/facts.generated.json";

/** A call to action, as authored in a content file's frontmatter. */
interface Cta {
	label: string;
	href: string;
}

/** The live read-only instance, linked from the hero and the run panel. */
const DEMO_URL = "https://app.warren.run";

/**
 * A CTA that leads to the warren repository carries the GitHub mark, so
 * a reader scanning the page sees where the button goes before reading
 * it. Driven by the href, not a frontmatter flag — the copy files decide
 * where a button points, and the mark follows.
 */
const isRepoLink = (href: string): boolean =>
	href.startsWith("https://github.com/jayminwest/warren");

/** External links leave the site, so they carry the usual rel guard. */
const relFor = (href: string): string | undefined =>
	href.startsWith("http") ? "noopener noreferrer" : undefined;

const hero = heroMeta as {
	eyebrow: string;
	headline: string;
	title: string;
	description: string;
	demoCta: Cta & { note: string };
	primaryCta: Cta;
	secondaryCta: Cta;
};
const howItWorks = howItWorksMeta as { eyebrow: string; heading: string; steps: Step[] };
const record = recordMeta as { eyebrow: string; heading: string };
const controlPlane = controlPlaneMeta as { eyebrow: string; heading: string };
const selfHost = selfHostMeta as { eyebrow: string; heading: string; cta: Cta };
const closing = closingMeta as { heading: string; cta: Cta };

/** The control-plane verbs, in the order `order` gives them in their frontmatter. */
const features = [
	{ meta: dispatchMeta, Body: DispatchBody },
	{ meta: sandboxMeta, Body: SandboxBody },
	{ meta: capMeta, Body: CapBody },
	{ meta: steerMeta, Body: SteerBody },
	{ meta: auditMeta, Body: AuditBody },
	{ meta: judgeMeta, Body: JudgeBody },
]
	.map((entry) => ({
		...entry,
		meta: entry.meta as {
			order: number;
			eyebrow: string;
			title: string;
			glyph: "send" | "shield" | "gauge" | "stream" | "receipt" | "scale";
		},
	}))
	.sort((a, b) => a.meta.order - b.meta.order);

/**
 * Numbers on this page come from `src/config/facts.generated.json`, which
 * `bun run sync:upstream` extracts mechanically from warren at the pinned
 * ref. Never hand-type one of these into the copy — it would drift the
 * moment the ref moves.
 */
const stats = [
	{ label: "Current release", value: facts.version },
	{ label: "HTTP API paths", value: String(facts.httpPathCount) },
	{ label: "CLI commands", value: String(facts.cliCommandCount) },
	{ label: "License", value: facts.license },
];

/**
 * The rows in the run panel. Warren's real event vocabulary — the kinds
 * are what the run event stream emits — with no invented timings or
 * counts. See the header of `RunPanel.astro`.
 */
const runEvents = [
	{ kind: "state", label: "state_change", detail: "queued → running" },
	{ kind: "tool", label: "tool_use", detail: "Read · auth/session.test.ts" },
	{ kind: "tool", label: "tool_use", detail: "Edit · auth/session.ts" },
	{ kind: "message", label: "message", detail: "also cover the expired-token case" },
	{ kind: "tool", label: "tool_use", detail: "Edit · auth/session.test.ts" },
	{ kind: "done", label: "state_change", detail: "running → succeeded · pull request opened" },
] satisfies readonly EventRow[];
---

<BaseLayout title={hero.title} description={hero.description}>
	<section class="hero">
		<div class="shell">
			<p class="eyebrow">{hero.eyebrow}</p>
			<h1>{hero.headline}</h1>
			<div class="lede"><HeroBody /></div>
			<a class="cta demo" href={hero.demoCta.href} rel="noopener noreferrer">
				<span class="pip" aria-hidden="true"></span>
				<span class="demo-label">{hero.demoCta.label}</span>
				<span class="demo-note">{hero.demoCta.note}</span>
			</a>
			<div class="ctas">
				<a class="cta primary" href={hero.primaryCta.href} rel={relFor(hero.primaryCta.href)}>
					{isRepoLink(hero.primaryCta.href) && <GitHubMark />}
					{hero.primaryCta.label}
				</a>
				<a
					class="cta secondary"
					href={hero.secondaryCta.href}
					rel={relFor(hero.secondaryCta.href)}
				>
					{isRepoLink(hero.secondaryCta.href) && <GitHubMark />}
					{hero.secondaryCta.label}
				</a>
			</div>
		</div>
	</section>

	<section class="shell sample">
		<RunPanel href={DEMO_URL} rows={runEvents} />
		<dl class="stats">
			{
				stats.map((stat) => (
					<div>
						<dt>{stat.label}</dt>
						<dd>{stat.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="shell block" aria-labelledby="record">
		<p class="eyebrow">{record.eyebrow}</p>
		<h2 id="record">{record.heading}</h2>
		<div class="prose"><RecordBody /></div>
	</section>

	<section class="shell steps" aria-labelledby="how-it-works">
		<p class="eyebrow">{howItWorks.eyebrow}</p>
		<h2 id="how-it-works">{howItWorks.heading}</h2>
		<div class="prose steps-lede"><HowItWorksBody /></div>
		<Pipeline steps={howItWorks.steps} />
	</section>

	<section class="shell block" aria-labelledby="features">
		<p class="eyebrow">{controlPlane.eyebrow}</p>
		<h2 id="features">{controlPlane.heading}</h2>
		<div class="prose steps-lede"><ControlPlaneBody /></div>
		<div class="features">
			{
				features.map(({ meta, Body }) => (
					<FeatureCard eyebrow={meta.eyebrow} title={meta.title} glyph={meta.glyph}>
						<Body />
					</FeatureCard>
				))
			}
		</div>
	</section>

	<section class="shell block" aria-labelledby="self-host">
		<p class="eyebrow">{selfHost.eyebrow}</p>
		<h2 id="self-host">{selfHost.heading}</h2>
		<div class="prose"><SelfHostBody /></div>
		<a class="cta secondary" href={selfHost.cta.href}>{selfHost.cta.label}</a>
	</section>

	<section class="shell closing" aria-labelledby="closing">
		<h2 id="closing">{closing.heading}</h2>
		<div class="prose"><ClosingBody /></div>
		<a class="cta primary" href={closing.cta.href} rel={relFor(closing.cta.href)}>
			{isRepoLink(closing.cta.href) && <GitHubMark />}
			{closing.cta.label}
		</a>
	</section>
</BaseLayout>

<style>
	/* Flat, per the field manual: no gradient — a hairline closes the hero. */
	.hero {
		padding-block: 4.5rem 3.5rem;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg);
	}

	/* The uppercase mono micro-label — the one sanctioned label style. */
	.eyebrow {
		margin: 0 0 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted-foreground);
	}

	h1 {
		margin: 0;
		max-width: 24ch;
		font-size: clamp(2.25rem, 5.5vw, 3.25rem);
		line-height: 1.05;
	}

	.lede {
		margin-top: 1.25rem;
		max-width: 64ch;
		color: var(--color-muted-foreground);
	}

	.lede :global(p) {
		margin: 0 0 0.75rem;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.lede :global(p:last-child) {
		margin-bottom: 0;
		color: var(--color-fg);
	}

	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	/*
	 * The live instance sits ABOVE the quickstart and source buttons and
	 * gets its own treatment: it is the only link on the page that shows
	 * warren actually running, so it should not read as a third button in
	 * a row of three.
	 */
	.cta.demo {
		gap: 0.625rem;
		margin-top: 2rem;
		border-color: color-mix(in oklab, var(--color-success) 45%, var(--color-border));
		background-color: var(--color-card);
		color: var(--color-fg);
	}

	.cta.demo:hover {
		border-color: var(--color-success);
	}

	/* Status marks are hard squares in the field manual, not dots. */
	.pip {
		width: 6px;
		height: 6px;
		background-color: var(--color-success);
	}

	.demo-label {
		font-weight: 500;
	}

	.demo-note {
		font-size: 0.75rem;
		color: var(--fm-faint);
	}

	@media (max-width: 34rem) {
		.demo-note {
			display: none;
		}
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1rem;
		border: 1px solid transparent;
		border-radius: 3px;
		font-size: 0.8125rem;
		font-weight: 500;
		text-decoration: none;
	}

	/* The primary action is the one place the accent fills a surface. */
	.cta.primary {
		background-color: var(--color-primary);
		color: var(--color-primary-foreground);
	}

	.cta.primary:hover {
		background-color: color-mix(in oklab, var(--color-primary) 92%, var(--color-fg));
	}

	/* Secondary actions are bordered objects, not a second button fill. */
	.cta.secondary {
		border-color: var(--fm-line-strong);
		background-color: transparent;
		color: var(--color-muted-foreground);
	}

	.cta.secondary:hover {
		border-color: var(--fm-line-strong);
		color: var(--color-fg);
	}

	.sample {
		padding-block: 3rem 0;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1rem;
		margin: 1.5rem 0 0;
	}

	/* Vitals: big mono numbers over faint micro-labels, accent unspent. */
	.stats dt {
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fm-faint);
	}

	.stats dd {
		margin: 0.25rem 0 0;
		font-size: 1.5rem;
		font-variant-numeric: tabular-nums;
		color: var(--color-fg);
	}

	.block,
	.steps {
		padding-block: 4rem 0;
	}

	h2 {
		margin: 0 0 1.5rem;
		font-size: clamp(1.5rem, 3.5vw, 1.85rem);
		line-height: 1.15;
	}

	.steps .eyebrow,
	.block .eyebrow {
		margin-bottom: 0.5rem;
	}

	.steps-lede {
		margin-bottom: 2rem;
	}

	/*
	 * Exactly three columns, not `auto-fit`. The six control-plane verbs
	 * fill two even rows of three, and `auto-fit` would reflow them to an
	 * uneven split at some widths, which looks like a card fell off a row.
	 */
	.features {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	@media (max-width: 62rem) {
		.features {
			grid-template-columns: 1fr;
		}
	}

	.prose {
		max-width: 68ch;
		color: var(--color-muted-foreground);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.prose :global(p) {
		margin: 0 0 1rem;
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		color: var(--color-fg);
		overflow-wrap: anywhere;
	}

	.block .cta {
		margin-top: 0.5rem;
	}

	.closing {
		padding-block: 4rem 0;
		text-align: center;
	}

	.closing h2 {
		max-width: 22ch;
		margin-inline: auto;
	}

	.closing .prose {
		margin: 0 auto 2rem;
	}
</style>
