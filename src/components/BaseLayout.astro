---
/**
 * Shell for the pages that live OUTSIDE Starlight's chrome — the landing
 * page and `/changelog`.
 *
 * Ships no client JavaScript except the analytics tags from
 * `src/config/analytics.ts` — the one sanctioned exception, added
 * 2026-08-13 for ad-campaign measurement. Everything else stays static
 * HTML + CSS: no hydration islands, no prefetch runtime, no theme toggle,
 * so the vendored tokens follow the OS preference through the
 * `:root:not([data-theme])` block in `starlight-overrides.css`. The
 * per-route budgets in `budgets/bundle-size-budgets.json` enforce exactly
 * this shape.
 */
import "../styles/warren-theme.css";
import "../styles/starlight-overrides.css";
import {
	GTAG_ID,
	GTAG_SEND_TO,
	gtagBootstrap,
	gtagLoaderSrc,
	VERCEL_INSIGHTS_SRC,
} from "../config/analytics";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
	title: string;
	description: string;
	/** Set on pages that should not be indexed (previews, drafts). */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://warren.run");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		{/*
			SVG first, PNG second: the SVG carries a `prefers-color-scheme`
			block so the mark stays legible on a light AND a dark tab strip,
			which a single raster cannot do. Browsers that ignore SVG icons
			fall back to the second link, whose PNG is transparent and
			mid-gray for the same reason.
		*/}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/icon.png" type="image/png" />
		<meta name="color-scheme" content="light dark" />
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		{/*
			The OPAQUE lockup, deliberately. A social card is composited onto
			a surface this site does not control, so a transparent asset would
			render light-gray-on-white in some clients. This is the one place
			the dark-canvas raster is the right answer.
		*/}
		<meta property="og:image" content={new URL("/logo.png", canonical).href} />
		<meta name="twitter:card" content="summary_large_image" />
		{/* Analytics — see the header of src/config/analytics.ts. */}
		<script is:inline defer src={VERCEL_INSIGHTS_SRC}></script>
		{
			GTAG_ID && (
				<>
					<script is:inline async src={gtagLoaderSrc(GTAG_ID)} />
					<script is:inline set:html={gtagBootstrap(GTAG_ID, GTAG_SEND_TO)} />
				</>
			)
		}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<style is:global>
	html {
		box-sizing: border-box;
		background-color: var(--color-bg);
		color: var(--color-fg);
		font-family: var(--font-sans);
		line-height: 1.6;
		-webkit-text-size-adjust: 100%;
	}

	*,
	*::before,
	*::after {
		box-sizing: inherit;
	}

	body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	main {
		flex: 1;
	}

	a {
		color: var(--color-primary);
	}

	:focus-visible {
		outline: 2px solid var(--color-ring);
		outline-offset: 2px;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		padding: 0.5rem 1rem;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		z-index: var(--z-modal);
	}

	.skip-link:focus {
		left: 1rem;
		top: 1rem;
	}

	/* Shared page rhythm for every section on a standalone page. */
	.shell {
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}
</style>
