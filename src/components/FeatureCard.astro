---
/**
 * One pillar on the landing page.
 *
 * The eyebrow, the glyph name, and the title come from a
 * `content/features/*.md` frontmatter block; the body is that file's
 * markdown, passed in as the default slot so the prose guard lints it.
 * Nothing here holds copy.
 *
 * The glyph is chosen by NAME from the table below rather than passed in
 * as markup, so a content file cannot inject arbitrary SVG and every card
 * draws from the same small set. Each path is a single stroke in
 * `currentColor`, and the whole `<svg>` is `aria-hidden`: the heading next
 * to it already says what the card is about, so an accessible name here
 * would be read out twice.
 */
type Glyph = "send" | "shield" | "gauge" | "stream" | "receipt" | "loop";

/** Stroke paths on a 24x24 grid, keyed by the name a content file gives. */
const GLYPHS: Record<Glyph, string> = {
	// A paper plane: the dispatch that starts a run.
	send: "m22 2-11 11M22 2 15 22l-4-9-9-4 20-7Z",
	// A shield: the sandbox each run is confined to.
	shield: "M12 3 4 6v6c0 4.5 3.4 7.6 8 9 4.6-1.4 8-4.5 8-9V6l-8-3Z",
	// A dial with its needle: the spend cap, read mid-run.
	gauge: "M4 15a8 8 0 0 1 16 0M12 15l4-5",
	// Stacked lines of unequal length: the event stream, tailing.
	stream: "M4 7h16M4 12h11M4 17h6",
	// A till receipt: the final record returned to Git.
	receipt: "M6 3h12v18l-3-2-3 2-3-2-3 2ZM9 8h6M9 12h6",
	// An arrow that returns on itself: intervention and recovery.
	loop: "M20 12a8 8 0 1 1-2.3-5.7M20 4v4h-4",
};

interface Props {
	/** Short label above the title, e.g. "Sandbox". */
	eyebrow: string;
	title: string;
	glyph: Glyph;
}

const { eyebrow, title, glyph } = Astro.props;
const path = GLYPHS[glyph];
---

<article class="card">
	<span class="icon" aria-hidden="true">
		<svg viewBox="0 0 24 24" focusable="false">
			<path d={path}></path>
		</svg>
	</span>
	<p class="eyebrow">{eyebrow}</p>
	<h3>{title}</h3>
	<div class="body"><slot /></div>
</article>

<style>
	/* A field-manual tile: panel surface, hairline, hard-ish corners. */
	.card {
		padding: 1rem 1.1rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		background-color: var(--color-card);
	}

	/* The glyph stands bare — no chip behind it, quiet ink. */
	.icon {
		display: inline-flex;
		margin-bottom: 0.9rem;
		color: var(--color-muted-foreground);
	}

	.icon svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* The uppercase mono micro-label — the one sanctioned label style. */
	.eyebrow {
		margin: 0 0 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted-foreground);
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
		line-height: 1.2;
	}

	.body {
		color: var(--color-muted-foreground);
		font-size: 0.8125rem;
		line-height: 1.6;
	}

	.body :global(p) {
		margin: 0;
	}

	.body :global(code) {
		font-family: var(--font-mono);
		color: var(--color-fg);
		overflow-wrap: anywhere;
	}
</style>
