---
/**
 * A static terminal transcript. No syntax highlighter and no client JS —
 * each line is tagged with its own kind and colored from the vendored
 * status tokens.
 *
 * `lines` is placeholder content when passed from the landing page.
 */
export type TerminalLine = {
	/** `prompt` renders a `$`; the rest are output styling. */
	kind: "prompt" | "out" | "muted" | "ok";
	text: string;
};

interface Props {
	title: string;
	lines: readonly TerminalLine[];
}

const { title, lines } = Astro.props;

/**
 * Rows are flattened here rather than in the template: `<pre>` preserves
 * every character between the tags, so the markup below has to stay on one
 * line with no incidental whitespace, and a multi-line JSX expression
 * inside it does not survive `astro check`'s JSX transform.
 */
const rows = lines.map((line) => ({
	kind: line.kind,
	text: line.kind === "prompt" ? `$ ${line.text}` : line.text,
}));
---

<figure class="terminal">
	<figcaption>
		<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
		<span class="title">{title}</span>
	</figcaption>
	<pre><code>{rows.map((row) => <span class:list={["line", row.kind]}>{row.text + "\n"}</span>)}</code></pre>
</figure>

<style>
	.terminal {
		margin: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background-color: var(--color-card);
		box-shadow: var(--shadow-md);
		overflow: hidden;
	}

	figcaption {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.625rem 1rem;
		border-bottom: 1px solid var(--color-border);
		background-color: var(--color-muted);
	}

	.dots {
		display: inline-flex;
		gap: 0.375rem;
	}

	.dots i {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 50%;
		background-color: var(--color-border);
	}

	.title {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted-foreground);
	}

	pre {
		margin: 0;
		padding: 1.25rem 1rem;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.7;
		font-variant-numeric: tabular-nums;
	}

	.line {
		display: block;
		white-space: pre;
	}

	.sigil {
		color: var(--color-primary);
		user-select: none;
	}

	.prompt {
		color: var(--color-fg);
	}

	.out {
		color: var(--color-fg);
	}

	.muted {
		color: var(--color-muted-foreground);
	}

	.ok {
		color: var(--color-success);
	}
</style>
