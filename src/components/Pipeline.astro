---
/**
 * The four stages of a warren run, as a diagram.
 *
 * This replaced a numbered markdown list. The list was accurate and
 * unreadable at a glance: the shape of the system — one path, four
 * stages, a sandbox in the middle, a pull request at the end — is the
 * thing a first-time reader needs, and prose is a poor way to show a
 * shape.
 *
 * Copy still lives in `content/how-it-works.md`, in a frontmatter `steps`
 * sequence. The prose guard reads frontmatter scalars (see
 * `scripts/prose-frontmatter.ts`), so those strings are linted exactly
 * like body text and this file holds none of them.
 *
 * CSS grid rather than one wide `<svg>`, so the diagram reflows to a
 * vertical stack on a narrow screen instead of scrolling sideways. The
 * connectors are `::after` pseudo-elements and rotate with the axis.
 *
 * ACCESSIBILITY: the stages are an ordered list, because their order is
 * the meaning. The connector arrows are decorative and hidden, and the
 * numbers come from `counter()` rather than from markup, so a screen
 * reader hears "1. Add a repository", not a bare glyph.
 */

/** One stage, as authored in `how-it-works.md` frontmatter. */
export type Step = {
	/** Short label on the connector, e.g. "Dispatch". */
	stage: string;
	title: string;
	body: string;
};

interface Props {
	steps: readonly Step[];
}

const { steps } = Astro.props;
---

<ol class="pipeline">
	{
		steps.map((step) => (
			<li class="stage">
				<span class="badge">{step.stage}</span>
				<span class="title">{step.title}</span>
				<span class="body">{step.body}</span>
			</li>
		))
	}
</ol>

<style>
	.pipeline {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: stage;
	}

	.stage {
		position: relative;
		display: grid;
		gap: 0.375rem;
		align-content: start;
		padding: 1.25rem 1rem 1.25rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background-color: var(--color-card);
		box-shadow: var(--shadow-sm);
		counter-increment: stage;
	}

	/*
	 * The connector. Drawn on the stage itself rather than as its own
	 * element so the markup stays a plain list, and suppressed on the last
	 * item because nothing follows it.
	 */
	.stage::after {
		content: "";
		position: absolute;
		top: 50%;
		right: calc(-1.75rem - 1px);
		width: 1.75rem;
		height: 1px;
		background-color: var(--color-border);
	}

	.stage:last-child::after {
		display: none;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	/* The step number, from a counter so it is never hard-typed. */
	.badge::before {
		content: counter(stage);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.5rem;
		height: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background-color: var(--color-muted);
		letter-spacing: 0;
	}

	.title {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.body {
		color: var(--color-muted-foreground);
		font-size: 0.875rem;
	}

	/* Two-by-two, then a single column. The connector follows the axis. */
	@media (max-width: 62rem) {
		.pipeline {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.25rem;
		}

		.stage::after {
			right: calc(-1.25rem - 1px);
			width: 1.25rem;
		}

		.stage:nth-child(2n)::after {
			display: none;
		}
	}

	@media (max-width: 34rem) {
		.pipeline {
			grid-template-columns: 1fr;
		}

		.stage::after,
		.stage:nth-child(2n)::after {
			display: block;
			top: auto;
			bottom: calc(-1.25rem - 1px);
			left: 2rem;
			right: auto;
			width: 1px;
			height: 1.25rem;
		}

		.stage:last-child::after {
			display: none;
		}
	}
</style>
